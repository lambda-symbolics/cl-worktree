(in-package #:cl-worktree)

(defvar *checks* 0)

(defun test-runner (argv &key directory input)
  "Execute real Git with a string input stream and capture all three results."
  (uiop:run-program argv :directory directory
                    :input (if input (make-string-input-stream input) :interactive)
                    :output :string :error-output :string :ignore-error-status t))

(defun verify (value)
  "Record an assertion."
  (incf *checks*)
  (unless value (error "Failed worktree check ~D" *checks*)))

(defmacro fails (type &body body)
  "Assert the expected typed failure."
  `(verify (handler-case (progn ,@body nil) (,type () t))))

(defun write-text (path text)
  "Write fixture contents."
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (write-string text stream)))

(defun commit-text (manager path text &optional (message "change"))
  "Commit a fixture edit."
  (write-text (merge-pathnames "file" (uiop:ensure-directory-pathname path)) text)
  (%run manager path '("add" "file"))
  (%run manager path (list "commit" "-m" message)))

(defun run-tests ()
  "Exercise real temporary Git repositories, failures and durable ownership."
  (let* ((*checks* 0)
         (root (merge-pathnames (format nil "cl-worktree-tests-~36R/" (random (expt 2 80)))
                               (uiop:temporary-directory)))
         (source (merge-pathnames "source/" root))
         (registry (merge-pathnames "registry/" root))
         (manager (make-manager :runner #'test-runner :registry registry)))
    (unwind-protect
         (progn
           (ensure-directories-exist (merge-pathnames "probe" source))
           (fails isolation-unavailable
             (create-worktree manager :source source :path (merge-pathnames "bad" root)
                              :baseline "HEAD" :owner "task"))
           (%run manager source '("init"))
           (%run manager source '("config" "user.name" "Worktree Tests"))
           (%run manager source '("config" "user.email" "tests@example.invalid"))
           (commit-text manager source (format nil "base~%") "baseline")
           (let* ((base (%revision manager source "HEAD"))
                  (branch (%trim (%run manager source '("symbolic-ref" "HEAD"))))
                  (tree (create-worktree manager :source source
                                         :path (merge-pathnames "child" root)
                                         :baseline base :owner "task")))
             (verify (equal base (worktree-baseline tree)))
             (verify (= 1 (length (discover-worktrees manager :owner "task"))))
             (verify (null (discover-worktrees manager :owner "other")))
             (fails ownership-error (cleanup-worktree manager tree :owner "other"))
             (verify (probe-file (worktree-path tree)))
             (fails ownership-error
               (create-worktree manager :source source :path (worktree-path tree)
                                :baseline base :owner "task"))
             (write-text (merge-pathnames "untracked" source) "dirt")
             (fails dirty-workspace
               (create-worktree manager :source source :path (merge-pathnames "dirty" root)
                                :baseline base :owner "task"))
             (let ((ignored (create-worktree manager :source source
                                             :path (merge-pathnames "ignored" root)
                                             :baseline base :owner "task"
                                             :dirty-policy :ignore)))
               (verify (not (probe-file (merge-pathnames "untracked"
                                                       (uiop:ensure-directory-pathname
                                                        (worktree-path ignored))))))
               (verify (equal base (%revision manager source "HEAD")))
               (cleanup-worktree manager ignored :owner "task"))
             (verify (probe-file (merge-pathnames "untracked" source)))
             (fails dirty-workspace (apply-patch manager source "invalid"))
             (delete-file (merge-pathnames "untracked" source))
             (let ((path (uiop:ensure-directory-pathname (worktree-path tree))))
               (write-text (merge-pathnames "file" path) (format nil "child~%"))
               (fails dirty-workspace (cleanup-worktree manager tree :owner "task"))
               (let ((patch (extract-patch manager tree :owner "task")))
                 (verify (equal '("file") (artifact-paths patch)))
                 (verify (check-patch manager source (artifact-content patch)))
                 (verify (apply-patch manager source (artifact-content patch)))
                 (verify (search "child" (%run manager source '("diff" "--cached"))))
                 (%run manager source '("reset" "--hard" "HEAD")))
               (commit-text manager path (format nil "child~%"))
               (let ((range (extract-commit-range manager tree :owner "task")))
                 (verify (= 1 (length (artifact-content range))))
                 (verify (apply-commit-range manager source range))
                 (verify (equal (artifact-tip range) (%revision manager source "HEAD")))
                 (%run manager source (list "reset" "--hard" base))
                 (commit-text manager source (format nil "parent~%"))
                 (let ((parent-tip (%revision manager source "HEAD")))
                   (fails integration-conflict (apply-commit-range manager source range))
                   (verify (equal '("file") (integration-conflicts manager source)))
                   (verify (abort-integration manager source))
                   (verify (equal parent-tip (%revision manager source "HEAD")))
                   (verify (null (integration-conflicts manager source)))
                   (fails integration-conflict
                     (check-patch manager source (artifact-content
                                                  (extract-patch manager tree :owner "task")))))
                 (verify (equal branch (%trim (%run manager source '("symbolic-ref" "HEAD"))))))
               ;; Cleanup errors preserve the durable handle for retry.
               (let ((failing (make-manager
                               :registry registry
                               :runner (lambda (argv &key directory input)
                                        (if (equal "remove"
                                                   (second (member "worktree" argv :test #'equal)))
                                             (values "" "injected removal failure" 1)
                                             (test-runner argv :directory directory :input input))))))
                 (fails cleanup-failure (cleanup-worktree failing tree :owner "task"))
                 (verify (= 1 (length (discover-worktrees manager)))))
               ;; A replacement marker must never authorize deletion.
               (let ((marker (%marker-path tree)) (data (%data tree)))
                 (%write-record marker '(:id "other"))
                 (fails ownership-error (cleanup-worktree manager tree :owner "task"))
                 (verify (probe-file path))
                 (%write-record marker data))
               (write-text (merge-pathnames "scratch" path) "discard")
               (verify (cleanup-worktree manager tree :owner "task" :discard-dirty t))
               (verify (eq :removed (worktree-state tree)))
               (verify (null (discover-worktrees manager)))
               (verify (not (probe-file path)))))
           (run-edge-tests manager root source)
           (run-provenance-tests manager root source)
           (run-rollback-tests manager root source)
           (format t "~D cl-worktree checks passed.~%" *checks*)
           t)
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun run-edge-tests (manager root source)
  "Exercise orphan recovery, malformed identity, binary patches and dirty indexes."
  (let ((base (%revision manager source "HEAD")))
    (fails command-failure
      (create-worktree manager :source source :path (merge-pathnames "invalid" root)
                       :baseline "missing-revision" :owner "edge"))
    (verify (not (probe-file (merge-pathnames "invalid" root))))
    (fails worktree-error
      (create-worktree manager :source source :path (merge-pathnames "invalid" root)
                       :baseline base :owner "edge" :dirty-policy :invented))
    (let* ((tree (create-worktree manager :source source
                                  :path (merge-pathnames "with spaces/" root)
                                  :baseline base :owner "edge"))
           (path (uiop:ensure-directory-pathname (worktree-path tree)))
           (before (%run manager source '("status" "--porcelain" "-z"))))
      (verify (null (artifact-content (extract-commit-range manager tree :owner "edge"))))
      (verify (apply-commit-range manager source (extract-commit-range manager tree :owner "edge")))
      (verify (check-patch manager source ""))
      (verify (apply-patch manager source ""))
      (verify (equal before (%run manager source '("status" "--porcelain" "-z"))))
      (write-text (merge-pathnames "new-file" path) "new content")
      (fails dirty-workspace (extract-patch manager tree :owner "edge"))
      (%run manager path '("add" "new-file"))
      (let ((patch (extract-patch manager tree :owner "edge")))
        (verify (equal '("new-file") (artifact-paths patch)))
        (verify (apply-patch manager source (artifact-content patch)))
        (verify (equal "new content" (uiop:read-file-string (merge-pathnames "new-file" source))))
        (fails dirty-workspace (apply-patch manager source ""))
        (%run manager source '("reset" "--hard" "HEAD")))
      (%run manager path '("reset" "--hard" "HEAD"))
      (let* ((name (format nil "binary~%name"))
             (bytes #(0 255 2 128 10 0)))
        (with-open-file (stream (merge-pathnames name path) :direction :output
                                :element-type '(unsigned-byte 8))
          (write-sequence bytes stream))
        (%run manager path (list "add" "--" name))
        (let ((patch (extract-patch manager tree :owner "edge")))
          (verify (equal (list name) (artifact-paths patch)))
          (verify (search "GIT binary patch" (artifact-content patch)))
          (verify (apply-patch manager source (artifact-content patch)))
          (with-open-file (stream (merge-pathnames name source) :element-type '(unsigned-byte 8))
            (let ((copy (make-array (file-length stream) :element-type '(unsigned-byte 8))))
              (read-sequence copy stream)
              (verify (equalp bytes copy))))
          (%run manager source '("reset" "--hard" "HEAD"))))
      (%run manager path '("reset" "--hard" "HEAD"))
      (write-text (merge-pathnames "file" source) "staged source")
      (%run manager source '("add" "file"))
      (write-text (merge-pathnames "file" source) "unstaged source")
      (let* ((status (%run manager source '("status" "--porcelain" "-z")))
             (ignored (create-worktree manager :source source :path (merge-pathnames "index-dirty" root)
                                      :baseline base :owner "edge" :dirty-policy :ignore)))
        (verify (equal status (%run manager source '("status" "--porcelain" "-z"))))
        (verify (equal "unstaged source" (uiop:read-file-string (merge-pathnames "file" source))))
        (fails dirty-workspace (apply-commit-range manager source
                                                 (extract-commit-range manager tree :owner "edge")))
        (verify (cleanup-worktree manager ignored :owner "edge")))
      (%run manager source '("reset" "--hard" "HEAD"))
      ;; A corrupt marker is a typed refusal, even if its reader form attempts evaluation.
      (let ((marker (%marker-path tree)) (data (%data tree)))
        (write-text marker "#.(error \"reader evaluation must be disabled\")")
        (fails ownership-error (cleanup-worktree manager tree :owner "edge"))
        (%write-record marker data)
        (delete-file marker)
        (fails ownership-error (cleanup-worktree manager tree :owner "edge"))
        (%write-record marker data))
      (let ((record (%record-path manager (worktree-id tree))))
        (delete-file record)
        (verify (null (discover-worktrees manager :owner "edge")))
        (verify (= 1 (length (discover-worktrees manager :source source :owner "edge"))))
        (verify (not (probe-file record)))
        ;; Discovery must not fabricate an owner for a manually created worktree.
        (let ((unowned (namestring (merge-pathnames "unowned" root))))
          (%run manager source (list "worktree" "add" "--detach" "--" unowned base))
          (verify (= 1 (length (discover-worktrees manager :source source :owner "edge"))))
          (verify (probe-file unowned))
          (%run manager source (list "worktree" "remove" "--" unowned)))
        ;; Git locks require an explicit unlock, even with discard requested.
        (%run manager source (list "worktree" "lock" "--" (worktree-path tree)))
        (fails cleanup-failure (cleanup-worktree manager tree :owner "edge" :discard-dirty t))
        (verify (probe-file path))
        (%run manager source (list "worktree" "unlock" "--" (worktree-path tree)))
        (verify (cleanup-worktree manager tree :owner "edge"))))
    (let ((tree (create-worktree manager :source source :path (merge-pathnames "orphan" root)
                                 :baseline base :owner "orphan")))
      (uiop:delete-directory-tree (uiop:ensure-directory-pathname (worktree-path tree)) :validate t)
      (multiple-value-bind (trees orphans) (discover-worktrees manager :source source :owner "orphan")
        (verify (= 1 (length trees)))
        (verify (= 1 (length orphans)))
        (verify (equal (worktree-id tree) (worktree-id (first orphans)))))
      (verify (cleanup-worktree manager tree :owner "orphan" :discard-dirty t))
      (verify (null (discover-worktrees manager))))
    (let ((tree (create-worktree manager :source source :path (merge-pathnames "pruned" root)
                                 :baseline base :owner "pruned")))
      (uiop:delete-directory-tree (uiop:ensure-directory-pathname (worktree-path tree)) :validate t)
      (%run manager source '("worktree" "prune" "--expire" "now"))
      (verify (cleanup-worktree manager tree :owner "pruned"))
      (verify (null (discover-worktrees manager))))
    (verify (equal base (%revision manager source "HEAD")))
    (%clean manager source)))

(defun run-provenance-tests (manager root source)
  "Verify portable secured artifacts and executable Git-feature suppression."
  (let* ((base (%revision manager source "HEAD"))
         (tree (create-worktree manager :source source :path (merge-pathnames "portable" root)
                                :baseline base :owner "portable"))
         (path (uiop:ensure-directory-pathname (worktree-path tree))))
    (write-text (merge-pathnames "file" path) "portable uncommitted change")
    (let* ((artifact (extract-patch manager tree :owner "portable"))
           (data (artifact->plist artifact :patch-reference "artifact:secured-patch"))
           (restored (plist->artifact data)))
      (verify (equal "portable" (getf data :owner)))
      (verify (equal (worktree-id tree) (getf data :worktree-id)))
      (verify (equal (namestring source) (concatenate 'string (getf data :source) "/")))
      (verify (equal (%trim (%run manager source '("rev-parse" "--path-format=absolute" "--git-common-dir")))
                     (getf data :common-git-directory)))
      (verify (equal (worktree-path tree) (getf data :isolated-path)))
      (verify (equal base (getf data :baseline)))
      (verify (equal base (getf data :tip)))
      (verify (equal '("file") (getf data :touched-paths)))
      (verify (equal (artifact-content artifact) (getf data :patch)))
      (verify (equal data (artifact->plist restored)))
      (verify (probe-file path))
      (verify (equal "portable uncommitted change" (uiop:read-file-string (merge-pathnames "file" path))))
      (fails dirty-workspace (cleanup-worktree manager tree :owner "portable"))
      ;; Secure the portable artifact before explicit destructive cleanup.
      (%write-record (merge-pathnames "artifact.sexp" root) data)
      (verify (cleanup-worktree manager tree :owner "portable" :discard-dirty t))
      (let ((secured (plist->artifact (%read-record (merge-pathnames "artifact.sexp" root)))))
        (verify (apply-patch manager source (artifact-content secured)))
        (verify (equal "portable uncommitted change" (uiop:read-file-string (merge-pathnames "file" source)))))
      (%run manager source '("reset" "--hard" "HEAD"))
      (dolist (invalid (list nil '(:version 2) '(:version 1 :kind "invented")
                            (list* :baseline "not-a-commit" data)
                            (list* :touched-paths '(42) data)))
        (fails worktree-error (plist->artifact invalid))))
    (let* ((range-tree (create-worktree manager :source source :path (merge-pathnames "range" root)
                                       :baseline base :owner "range"))
           (range-path (uiop:ensure-directory-pathname (worktree-path range-tree))))
      (write-text (merge-pathnames "first" range-path) "first change")
      (%run manager range-path '("add" "first"))
      (%run manager range-path '("commit" "-m" "first"))
      (commit-text manager range-path "second change" "second")
      (let* ((artifact (extract-commit-range manager range-tree :owner "range"))
             (data (artifact->plist artifact))
             (restored (plist->artifact data)))
        (verify (= 2 (length (getf data :commits))))
        (verify (equal data (artifact->plist restored)))
        (verify (stringp (getf data :patch)))
        (setf (artifact-content restored) (reverse (artifact-content restored)))
        (fails worktree-error (apply-commit-range manager source restored))
        (verify (equal base (%revision manager source "HEAD")))
        (commit-text manager source "conflicting parent" "conflict")
        (let ((before (%revision manager source "HEAD")))
          (fails integration-conflict (apply-commit-range manager source artifact))
          (verify (probe-file (merge-pathnames "first" source)))
          (verify (abort-integration manager source))
          (verify (equal before (%revision manager source "HEAD")))
          (verify (not (probe-file (merge-pathnames "first" source)))))
        (%run manager source (list "reset" "--hard" base)))
      (verify (cleanup-worktree manager range-tree :owner "range")))
    #+unix
    (let* ((hooks (merge-pathnames "unsafe-hooks/" root))
           (marker (merge-pathnames "unexpected-execution" root))
           (script (format nil "#!/bin/sh~%printf unexpected > '~A'~%cat~%" (namestring marker))))
      (ensure-directories-exist (merge-pathnames "probe" hooks))
      (dolist (name '("post-checkout" "post-commit" "fsmonitor"))
        (let ((hook (merge-pathnames name hooks)))
          (write-text hook script)
          (uiop:run-program (list "chmod" "+x" (namestring hook)))))
      (%run manager source (list "config" "core.hooksPath" (namestring hooks)))
      (%run manager source (list "config" "core.fsmonitor" (namestring (merge-pathnames "fsmonitor" hooks))))
      (%run manager source '("config" "filter.unsafe.smudge" "false"))
      (%run manager source '("config" "filter.unsafe.clean" "false"))
      (%run manager source '("config" "filter.unsafe.process" "false"))
      (%run manager source '("config" "filter.unsafe.required" "true"))
      (write-text (merge-pathnames ".gitattributes" source) (format nil "file filter=unsafe~%"))
      (%run manager source '("add" ".gitattributes"))
      (%run manager source '("commit" "-m" "unsafe features configured"))
      (let ((safe (create-worktree manager :source source :path (merge-pathnames "safe" root)
                                   :baseline "HEAD" :owner "safe")))
        (verify (not (probe-file marker)))
        (verify (equal (uiop:read-file-string (merge-pathnames "file" source))
                       (uiop:read-file-string
                        (merge-pathnames "file" (uiop:ensure-directory-pathname (worktree-path safe))))))
        (%clean manager (worktree-path safe))
        (verify (cleanup-worktree manager safe :owner "safe")))
      (verify (not (probe-file marker)))
      (dolist (key '("core.hooksPath" "core.fsmonitor" "filter.unsafe.smudge"
                     "filter.unsafe.clean" "filter.unsafe.process" "filter.unsafe.required"))
        (%run manager source (list "config" "--unset" key)))
      (%run manager source (list "reset" "--hard" base)))
    (verify (equal base (%revision manager source "HEAD")))
    (%clean manager source)))

(defun run-rollback-tests (manager root source)
  "Exercise interrupted creation without discarding intervening work, and renames."
  (let ((base (%revision manager source "HEAD")))
    (fails isolation-unavailable
      (create-worktree manager :source (merge-pathnames "missing-source/" root)
                       :path (merge-pathnames "unavailable" root) :baseline base :owner "missing"))
    (dolist (name '("MERGE_HEAD" "CHERRY_PICK_HEAD" "REVERT_HEAD"))
      (let ((marker (%trim (%run manager source
                                (list "rev-parse" "--path-format=absolute" "--git-path" name)))))
        (write-text marker (format nil "~A~%" base))
        (fails integration-conflict (apply-patch manager source ""))
        (verify (probe-file marker))
        (verify (equal base (%revision manager source "HEAD")))
        (delete-file marker)))
    (dolist (dirty '(nil t))
      (let* ((destination (namestring (merge-pathnames (if dirty "rollback-dirty" "rollback-clean") root)))
             (created nil)
             (injected (make-manager
                        :registry (manager-registry manager)
                        :runner (lambda (argv &key directory input)
                                  (if (and created (equal directory destination)
                                           (member "rev-parse" argv :test #'equal))
                                      (values "" "injected post-create inspection failure" 1)
                                      (multiple-value-bind (out err code)
                                          (test-runner argv :directory directory :input input)
                                        (when (and (zerop code)
                                                   (equal "add" (second (member "worktree" argv :test #'equal))))
                                          (setf created t)
                                          (when dirty
                                            (write-text (merge-pathnames "valuable"
                                                                       (uiop:ensure-directory-pathname destination))
                                                        "must survive")))
                                        (values out err code)))))))
        (if dirty
            (progn
              (fails cleanup-failure
                (create-worktree injected :source source :path destination :baseline base :owner "rollback"))
              (verify (equal "must survive"
                             (uiop:read-file-string
                              (merge-pathnames "valuable" (uiop:ensure-directory-pathname destination)))))
              ;; The fixture owner explicitly disposes of the retained partial creation.
              (%run manager source (list "worktree" "remove" "--force" "--" destination)))
            (progn
              (fails isolation-unavailable
                (create-worktree injected :source source :path destination :baseline base :owner "rollback"))
              (verify (not (probe-file destination)))))))
    (let* ((tree (create-worktree manager :source source :path (merge-pathnames "rename" root)
                                  :baseline base :owner "rename"))
           (path (uiop:ensure-directory-pathname (worktree-path tree))))
      (%run manager path '("mv" "file" "renamed"))
      (let ((patch (extract-patch manager tree :owner "rename")))
        (verify (equal '("file" "renamed") (artifact-paths patch)))
        (verify (apply-patch manager source (artifact-content patch)))
        (verify (not (probe-file (merge-pathnames "file" source))))
        (verify (probe-file (merge-pathnames "renamed" source))))
      (%run manager source '("reset" "--hard" "HEAD"))
      (%run manager path '("reset" "--hard" "HEAD"))
      (%run manager path '("rm" "file"))
      (let ((patch (extract-patch manager tree :owner "rename")))
        (verify (equal '("file") (artifact-paths patch)))
        (verify (apply-patch manager source (artifact-content patch)))
        (verify (not (probe-file (merge-pathnames "file" source)))))
      (%run manager source '("reset" "--hard" "HEAD"))
      (verify (cleanup-worktree manager tree :owner "rename" :discard-dirty t)))
    (verify (equal base (%revision manager source "HEAD")))
    (verify (null (discover-worktrees manager)))
    (%clean manager source)))
